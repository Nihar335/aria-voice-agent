# Copy this file to ".env" and paste your real keys there.
# .env is in .gitignore, so your keys never go to GitHub.

# Get it free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get it free at https://console.groq.com/keys
GROQ_API_KEY=

# Which LLM to use first: "gemini" or "groq". The other one is the automatic backup.
LLM_PROVIDER=groq

# Model names (change here, no code change needed).
# Several models separated by commas = backups, tried in order.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_EMBED_MODEL=gemini-embedding-001

# Password for the admin page (http://localhost:8000/admin.html) where you upload
# knowledge files. Leave empty to disable the admin page. Use a long random value.
ADMIN_PASSWORD=

# ===================== The 7-layer stack (all optional, safe defaults) =====================
# Layer 7 - router: simple FAQ/small-talk turns use these FAST models first (booking/tool turns use the lists above)
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
ROUTER_ENABLED=true
# Layer 7 - answer cache for repeated FAQ questions (seconds)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
# Layer 6 - guardrails + rate limits
GUARDRAILS_ENABLED=true
MAX_TURNS_PER_MINUTE=20
MAX_CALLS_PER_HOUR_PER_IP=30
# Layer 5 - Google sign-in for the admin page (console.cloud.google.com > APIs & Services > Credentials >
# OAuth client ID, type "Web application", redirect URI = <PUBLIC_BASE_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# These emails become admin the first time they sign in with Google (comma-separated)
ADMIN_EMAILS=
# Layer 4 - role used by MCP clients of mcp_server.py: viewer | sales_rep | manager | admin
MCP_ROLE=sales_rep
# Layer 8 - optional prices to show cost in traces, USD per 1M tokens "model=input/output", comma-separated.
# Check your provider's pricing page; leave empty on free tiers.
MODEL_PRICES=
