# Copy this file to ".env" and paste your real keys there.
# .env is in .gitignore, so your keys never go to GitHub.

# Get it free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get it free at https://console.groq.com/keys
GROQ_API_KEY=

# Which LLM to use first: "gemini" or "groq". The other one is the automatic backup.
LLM_PROVIDER=groq

# Model names (change here, no code change needed).
# Several models separated by commas = backups, tried in order.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_EMBED_MODEL=gemini-embedding-001

# Password for the admin page (http://localhost:8000/admin.html) where you upload
# knowledge files. Leave empty to disable the admin page. Use a long random value.
ADMIN_PASSWORD=
